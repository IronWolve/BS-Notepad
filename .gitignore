# GitHub: reviewed source, pictures, and license notices only.
# README.md and .gitignore are the only files tracked at the Git root.
/*
!/.gitignore
!/README.md
!/licenses/
/licenses/*
!/licenses/COPYRIGHT
!/licenses/THIRD-PARTY-NOTICES.txt
!/pics/
/pics/*
!/pics/brand.png
!/pics/brand-banner.png
!/pics/screenshots/
/pics/screenshots/*
!/pics/screenshots/images.png
!/pics/screenshots/themes.png
!/pics/screenshots/workspace.png
!/src/
/src/*
!/src/assets.rs
!/src/editing.js
!/src/dialogs.rs
!/src/disk.rs
!/src/documents.rs
!/src/find.js
!/src/fonts.rs
!/src/formatting.rs
!/src/icon.rs
!/src/image_viewer.js
!/src/instance.rs
!/src/jobs.rs
!/src/log.rs
!/src/mac_menu.rs
!/src/main.rs
!/src/maintenance.rs
!/src/paths.rs
!/src/preferences.rs
!/src/recovery.rs
!/src/render.rs
!/src/root.rs
!/src/settings.rs
!/src/storage.rs
!/src/theme.rs
!/src/tray.rs
!/src/tree.rs
!/src/ui.rs
!/src/workspace.js
!/src/workspace_files.rs
!/src/workspace_tools.js

# Local build and test inputs are not part of the public checkout.
/.cargo/
/Cargo.*
/build.*
/scripts/
/tests/
/tools/
/third-party/
/thirdparty/
/assets/
/COPYRIGHT
/THIRD-PARTY-NOTICES.txt
/src/tests.rs
/src/smoke.js

# Private data and generated output stay excluded at every directory depth.
# Keep these rules after the explicit source allowlist above.
# Ignore rules do not remove files or metadata already in Git history.

# Credentials and personal configuration
.env
.env.*
.config/
.ssh/
secrets/
credentials/
credentials.json
credentials*.json
secrets*.json
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
.npmrc
.netrc

# Application state, recovery copies and embedded-browser profiles
settings.json
settings.json.*
instance.port
instance.lock
recovery/
*-data/
*.WebView2/
logs/
*.log

# Builds, packages, dependencies, caches and scratch files
target/
tmp/
temp/
run/
dist/
dists/
deploy/
.cache/
.venv/
venv/
node_modules/
__pycache__/
*.pyc
*.exe
*.dll
*.so
*.dylib
*.pdb
*.app/
*.dSYM/
*.zip
*.tar
*.tar.gz
*.7z
*.dmg
*.msi

# Private notes, local instructions, editor state and backups
docs/
AGENTS.md
agent.md
CLAUDE.md
.agents/
.codex/
.idea/
.vscode/
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.bak
