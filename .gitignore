# Track only reviewed application source, required assets, and public notices.
# Build inputs, tests, tools, and dependency support files remain local.
/*
!/.gitignore
!/COPYRIGHT
!/README.md
!/THIRD-PARTY-NOTICES.txt
!/assets/
/assets/*
!/assets/brand.png
!/assets/screenshots/
/assets/screenshots/*
!/assets/screenshots/images.png
!/assets/screenshots/themes.png
!/assets/screenshots/workspace.png
!/src/
/src/*
!/src/assets.rs
!/src/documents.rs
!/src/find.js
!/src/fonts.rs
!/src/formatting.rs
!/src/icon.rs
!/src/image_viewer.js
!/src/instance.rs
!/src/jobs.rs
!/src/log.rs
!/src/mac_menu.rs
!/src/main.rs
!/src/maintenance.rs
!/src/recovery.rs
!/src/render.rs
!/src/root.rs
!/src/settings.rs
!/src/storage.rs
!/src/theme.rs
!/src/tray.rs
!/src/tree.rs
!/src/ui.rs
!/src/workspace.js

# Local build, test, and dependency support files.
/.cargo/
/Cargo.toml
/Cargo.lock
/build.rs
/scripts/
/tests/
/tools/
/third-party/
/src/tests.rs
/src/smoke.js

# Private data and generated output stay excluded at every directory depth.
# Keep these rules after the explicit source allowlist above.
# Ignore rules do not remove files or metadata already in Git history.

# Credentials and personal configuration
.env
.env.*
.config/
.ssh/
secrets/
credentials/
credentials.json
credentials*.json
secrets*.json
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
.npmrc
.netrc

# Application state, recovery copies and embedded-browser profiles
settings.json
settings.json.*
instance.port
instance.lock
recovery/
*-data/
*.WebView2/
logs/
*.log

# Builds, packages, dependencies, caches and scratch files
target/
tmp/
temp/
run/
dist/
dists/
deploy/
.cache/
.venv/
venv/
node_modules/
__pycache__/
*.pyc
*.exe
*.dll
*.so
*.dylib
*.pdb
*.app/
*.dSYM/
*.zip
*.tar
*.tar.gz
*.7z
*.dmg
*.msi

# Private notes, local instructions, editor state and backups
docs/
AGENTS.md
agent.md
CLAUDE.md
.agents/
.codex/
.idea/
.vscode/
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.bak
