# Only reviewed source and reproducible build inputs belong in this tree.
/*
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/build.rs
!/.cargo/
/.cargo/*
!/.cargo/config.toml
!/src/
/src/*
!/src/assets.rs
!/src/documents.rs
!/src/fonts.rs
!/src/formatting.rs
!/src/icon.rs
!/src/instance.rs
!/src/log.rs
!/src/main.rs
!/src/render.rs
!/src/root.rs
!/src/settings.rs
!/src/tests.rs
!/src/theme.rs
!/src/tray.rs
!/src/tree.rs
!/src/ui.rs
!/src/workspace.js
!/src/smoke.js
!/scripts/
/scripts/*
!/scripts/build.sh
!/scripts/check-portable.sh
!/scripts/register-file-types.ps1

!/assets/
/assets/*
!/assets/brand.png

!/src/find.js
!/src/storage.rs
!/src/jobs.rs
!/src/recovery.rs
!/src/maintenance.rs
!/tests/
/tests/*
!/tests/ui-fixture.js
!/tests/ui-regressions.js
!/tests/sidebar-regressions.js
!/tests/appearance-regressions.js
!/scripts/check-ui.sh

!/src/mac_menu.rs
!/scripts/build-macos.sh
!/tools/
/tools/*
!/tools/export-icon.rs

!/src/image_viewer.js
!/tests/image-regressions.js
!/scripts/package-release.py
!/scripts/build-env.sh
!/tests/markdown-image-regressions.js

# Public project overview and reviewed presentation assets.
!/README.md
!/assets/screenshots/
/assets/screenshots/*
!/assets/screenshots/workspace.png
!/assets/screenshots/themes.png
!/assets/screenshots/images.png

# Reviewed copyright notices and third-party source required for redistribution.
!/COPYRIGHT
!/THIRD-PARTY-NOTICES.txt
!/third-party/
/third-party/*
!/third-party/manifest.json
!/third-party/option-ext-0.2.0/
/third-party/option-ext-0.2.0/*
!/third-party/option-ext-0.2.0/Cargo.toml
!/third-party/option-ext-0.2.0/Cargo.toml.orig
!/third-party/option-ext-0.2.0/README.md
!/third-party/option-ext-0.2.0/LICENSE.txt
!/third-party/option-ext-0.2.0/src/
/third-party/option-ext-0.2.0/src/*
!/third-party/option-ext-0.2.0/src/lib.rs
!/third-party/option-ext-0.2.0/src/impl.rs
!/third-party/rust/
/third-party/rust/*
!/third-party/rust/COPYRIGHT-library.html
!/third-party/rust/licenses/
/third-party/rust/licenses/*
!/third-party/rust/licenses/Apache-2.0.txt
!/third-party/rust/licenses/BSD-2-Clause.txt
!/third-party/rust/licenses/CC-BY-SA-4.0.txt
!/third-party/rust/licenses/GCC-exception-3.1.txt
!/third-party/rust/licenses/GPL-2.0-only.txt
!/third-party/rust/licenses/GPL-3.0-or-later.txt
!/third-party/rust/licenses/ISC.txt
!/third-party/rust/licenses/LLVM-exception.txt
!/third-party/rust/licenses/MIT.txt
!/third-party/rust/licenses/NCSA.txt
!/third-party/rust/licenses/OFL-1.1.txt
!/third-party/rust/licenses/Unicode-3.0.txt

# Private data and generated output stay excluded at every directory depth.
# Keep these rules after the explicit source allowlist above.
# Ignore rules do not remove files or metadata already in Git history.

# Credentials and personal configuration
.env
.env.*
.config/
.ssh/
secrets/
credentials/
credentials.json
credentials*.json
secrets*.json
*.pem
*.key
*.p12
*.pfx
*.keystore
id_rsa
id_ed25519
.npmrc
.netrc

# Application state, recovery copies and embedded-browser profiles
settings.json
settings.json.*
instance.port
instance.lock
recovery/
*-data/
*.WebView2/
logs/
*.log

# Builds, packages, dependencies, caches and scratch files
target/
tmp/
temp/
run/
dist/
dists/
deploy/
.cache/
.venv/
venv/
node_modules/
__pycache__/
*.pyc
*.exe
*.dll
*.so
*.dylib
*.pdb
*.app/
*.dSYM/
*.zip
*.tar
*.tar.gz
*.7z
*.dmg
*.msi

# Private notes, local instructions, editor state and backups
docs/
AGENTS.md
agent.md
CLAUDE.md
.agents/
.codex/
.idea/
.vscode/
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.bak
